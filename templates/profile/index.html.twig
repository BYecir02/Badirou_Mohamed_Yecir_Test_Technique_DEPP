{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
    <h1>Mon profil</h1>
    <p>
        <strong>Nom d’utilisateur :</strong>
        {{ app.user.username }}
    </p>
    <p>
        <strong>Adresse e-mail :</strong>
        {{ app.user.email }}
    </p>
    <p>
        <strong>Rôle :</strong>
        {% if 'ROLE_ADMIN' in app.user.roles %}
            Administrateur
        {% else %}
            Utilisateur
        {% endif %}
    </p>
    {% if app.user.infos %}
        <h2>Mes informations</h2>

        <p>
            <strong>Rang :</strong>
            {{ app.user.infos.rank }}
        </p>

        <p>
            <strong>Victoires :</strong>
            {{ app.user.infos.victoire }}
        </p>

        <p>
            <strong>Défaites :</strong>
            {{ app.user.infos.defaite }}
        </p>
    {% else %}
        <p>Aucune information disponible pour le moment.</p>
    {% endif %}
    <a href="{{ path('app_logout') }}">Se déconnecter</a>
{% endblock %}