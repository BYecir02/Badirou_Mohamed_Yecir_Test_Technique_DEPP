{{ form_start(form, {
    attr: {
        class: 'admin-form'
    }
}) }}

    <div class="card card-form">
        <div class="form-group">
            {{ form_label(form.username) }}
            {{ form_widget(form.username, {
                attr: {
                    placeholder: 'Entrez un nom d’utilisateur'
                }
            }) }}
            {{ form_errors(form.username) }}
        </div>

        <div class="form-group">
            {{ form_label(form.email) }}
            {{ form_widget(form.email, {
                attr: {
                    placeholder: 'Entrez une adresse e-mail'
                }
            }) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="form-group">
            {{ form_label(form.role) }}
            {{ form_widget(form.role) }}
            {{ form_errors(form.role) }}
        </div>

        <div class="form-group">
            {{ form_label(form.plainPassword) }}
            {{ form_widget(form.plainPassword, {
                attr: {
                    placeholder: password_required
                        ? 'Entrez un mot de passe'
                        : 'Laissez vide pour conserver le mot de passe'
                }
            }) }}

            {{ form_errors(form.plainPassword) }}

            {% if not password_required %}
                <p class="form-help">
                    Laissez ce champ vide pour conserver le mot de passe actuel.
                </p>
            {% endif %}
        </div>
    </div>

    <div class="form-actions">
        <a href="{{ cancel_path }}" class="btn btn-outline">
            Annuler
        </a>

        <button type="submit" class="btn btn-primary">
            {{ button_label }}
        </button>
    </div>

{{ form_end(form) }}