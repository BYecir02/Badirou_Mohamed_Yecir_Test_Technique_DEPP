{% extends 'base.html.twig' %}

{% block title %}Modifier l’utilisateur{% endblock %}

{% block body %}
    <div class="form-page">
        <div class="page-header">
            {{ include('_ariane.html.twig', { items: [
                { label: 'Utilisateurs',   url: path('app_user_index') },
                { label: user.username,    url: path('app_user_show', {id: user.id}) },
                { label: 'Modifier',       url: null }
            ]}) }}

            <h1>Modifier l’utilisateur</h1>
            <p>Mettez à jour les informations du compte.</p>
        </div>

        {{ include('user/_form.html.twig', {
            button_label: 'Enregistrer les modifications',
            password_required: false,
            cancel_path: path('app_user_show', {'id': user.id})
        }) }}
    </div>
{% endblock %}