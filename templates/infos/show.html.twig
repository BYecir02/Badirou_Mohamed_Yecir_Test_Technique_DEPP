{% extends 'base.html.twig' %}

{% block title %}Détail des informations{% endblock %}

{% block body %}
    <h1>Informations de {{ info.user.username }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Utilisateur</th>
                <td>{{ info.user.username }}</td>
            </tr>

            <tr>
                <th>Rang</th>
                <td>{{ info.rank }}</td>
            </tr>

            <tr>
                <th>Victoires</th>
                <td>{{ info.victoire }}</td>
            </tr>

            <tr>
                <th>Défaites</th>
                <td>{{ info.defaite }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_infos_index') }}">
        Retour à la liste
    </a>

    <a href="{{ path('app_infos_edit', {'id': info.id}) }}">
        Modifier
    </a>

    {{ include('infos/_delete_form.html.twig') }}
{% endblock %}