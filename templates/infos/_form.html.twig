{{ form_start(form, {
    attr: {
        class: 'admin-form'
    }
}) }}

    <div class="card card-form">
        <div class="form-group">
            {{ form_label(form.rank) }}
            {{ form_widget(form.rank, {
                attr: {
                    placeholder: 'Entrez le rang'
                }
            }) }}
            {{ form_errors(form.rank) }}
        </div>

        <div class="form-group">
            {{ form_label(form.victoire) }}
            {{ form_widget(form.victoire, {
                attr: {
                    placeholder: 'Entrez le nombre de victoires'
                }
            }) }}
            {{ form_errors(form.victoire) }}
        </div>

        <div class="form-group">
            {{ form_label(form.defaite) }}
            {{ form_widget(form.defaite, {
                attr: {
                    placeholder: 'Entrez le nombre de défaites'
                }
            }) }}
            {{ form_errors(form.defaite) }}
        </div>

        {% if form.user is defined %}
            <div class="form-group">
                {{ form_label(form.user) }}
                {{ form_widget(form.user) }}
                {{ form_errors(form.user) }}
            </div>
        {% endif %}
    </div>

    <div class="form-actions">
        <a href="{{ cancel_path }}" class="btn btn-outline">
            Annuler
        </a>

        <button type="submit" class="btn btn-primary">
            {{ button_label }}
        </button>
    </div>

{{ form_end(form) }}