<form
    method="post"
    action="{{ path('app_infos_delete', {'id': info.id}) }}"
    onsubmit="return confirm('Voulez-vous vraiment supprimer ces informations ?');"
>
    <input
        type="hidden"
        name="_token"
        value="{{ csrf_token('delete' ~ info.id) }}"
    >
    <button type="submit" class="btn btn-danger">
        Supprimer les informations
    </button>
</form>