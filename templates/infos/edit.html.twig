{% extends 'base.html.twig' %}

{% block title %}Modifier les informations{% endblock %}

{% block body %}
    <div class="form-page">
        <div class="page-header">
            {{ include('_ariane.html.twig', { items: [
                { label: 'Utilisateurs',             url: path('app_user_index') },
                { label: info.user.username,         url: path('app_user_show', {id: info.user.id}) },
                { label: 'Modifier les informations', url: null }
            ]}) }}

            <h1>Modifier les informations</h1>
            <p>Mettez à jour les informations de cet utilisateur.</p>
        </div>

        {{ include('infos/_form.html.twig', {
            button_label: 'Enregistrer les modifications',
            cancel_path: path('app_user_show', {'id': info.user.id})
        }) }}
    </div>
{% endblock %}