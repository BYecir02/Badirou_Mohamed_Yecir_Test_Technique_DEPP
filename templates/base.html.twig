<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}Application{% endblock %}</title>

    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}
</head>

<body class="{% block body_class %}{% endblock %}">
    {% if app.user %}
        {% set currentRoute = app.request.attributes.get('_route') %}

        <header class="navbar">
            <div class="container navbar-content">
                <nav class="navbar-nav">
                    {% if is_granted('ROLE_ADMIN') %}
                        <a
                            href="{{ path('app_user_index') }}"
                            class="nav-link {{ currentRoute starts with 'app_user_' or currentRoute starts with 'app_infos_' or currentRoute == 'app_csv_import' ? 'active' : '' }}"
                        >
                            Utilisateurs
                        </a>
                    {% endif %}

                    <a
                        href="{{ path('app_profile') }}"
                        class="nav-link {{ currentRoute == 'app_profile' ? 'active' : '' }}"
                    >
                        Mon profil
                    </a>

                    <a href="{{ path('app_logout') }}" class="btn btn-outline">
                        Déconnexion
                    </a>
                </nav>
            </div>
        </header>
    {% endif %}

    <main class="main-content">
        <div class="container">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    {{ message }}
                </div>
            {% endfor %}

            {% block body %}{% endblock %}
        </div>
    </main>
</body>
</html>